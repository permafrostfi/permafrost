# build output
target/
**/target/
__pycache__/
*.pyc

# campaign logs — regenerated by run_campaign.sh, never committed
campaign/
*.log

# ---- SECRETS: never commit any of these ----
# Solana keypairs. A deploy or upgrade-authority keypair in git — even a private
# repo — is unrecoverable once pushed: history keeps it after deletion.
*-keypair.json
id.json
*.keypair
**/.config/solana/
.env
.env.*
